generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String?
  googleId     String?      @unique
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  sentInvites  Invite[]     @relation("SentInvite")
  connectionsA Connection[] @relation("ConnectionA")
  connectionsB Connection[] @relation("ConnectionB")
}

enum InviteStatus {
  pending
  accepted
  rejected
  cancelled
  superseded
}

model Invite {
  id         String       @id @default(cuid())
  fromUserId String
  toEmail    String
  expiresAt  DateTime
  status     InviteStatus @default(pending)
  resolvedAt DateTime?
  createdAt  DateTime     @default(now())
  fromUser   User         @relation("SentInvite", fields: [fromUserId], references: [id])
}

model Connection {
  id          String    @id @default(cuid())
  userAId     String
  userBId     String
  acceptedAt  DateTime
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  userA       User      @relation("ConnectionA", fields: [userAId], references: [id])
  userB       User      @relation("ConnectionB", fields: [userBId], references: [id])

  @@unique([userAId, userBId])
}

model Admin {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
